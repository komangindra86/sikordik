# Template, bukan konfigurasi siap deploy. Isi domain dan secret melalui deployment.
APP_NAME=SIKORDIK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sikordik.example.invalid
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sikordik
DB_USERNAME=sikordik_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log

# Isi provider SMTP yang nyata; verifikasi TLS dan delivery sebelum peluncuran.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Inject sementara melalui CLI deployment sebelum config:cache, lalu hapus secret.
INITIAL_ADMIN_NAME="Super Admin"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
VITE_APP_NAME="${APP_NAME}"

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
QPDF_BINARY=qpdf
